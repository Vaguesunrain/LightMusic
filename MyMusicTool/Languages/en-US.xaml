<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Top Navigation Tabs -->
    <sys:String x:Key="Nav_Albums">Albums</sys:String>
    <sys:String x:Key="Nav_Songs">Songs</sys:String>
    <sys:String x:Key="Nav_Artists">Artists</sys:String>
    <sys:String x:Key="Nav_Folders">Folders</sys:String>
    <sys:String x:Key="Nav_Queue">Queue</sys:String>

    <!-- Search Box & Top Toolbar -->
    <sys:String x:Key="Hint_Search">Search music...</sys:String>
    <sys:String x:Key="Tip_AddFolder">Add local music folder</sys:String>
    <sys:String x:Key="Tip_LyricSettings">Taskbar lyrics appearance &amp; position</sys:String>
    <sys:String x:Key="Tip_MinimizeToTray">Minimize to tray (free cover cache)</sys:String>
    <sys:String x:Key="Tip_Minimize">Minimize</sys:String>
    <sys:String x:Key="Tip_Maximize">Maximize</sys:String>
    <sys:String x:Key="Tip_Exit">Exit</sys:String>
    <sys:String x:Key="Tray_Tooltip">MyMusicTool (Double-click to restore)</sys:String>

    <!-- Taskbar Lyrics Settings Popup -->
    <sys:String x:Key="LyricSet_Title">Taskbar Lyrics Settings</sys:String>
    <sys:String x:Key="LyricSet_Font">Font Family</sys:String>
    <sys:String x:Key="LyricSet_FontSize">Font Size</sys:String>
    <sys:String x:Key="LyricSet_BgOpacity">Capsule Opacity</sys:String>
    <sys:String x:Key="LyricSet_ColorProgress">Enable karaoke color progress</sys:String>
    <sys:String x:Key="LyricSet_ShowCover">Show mini album cover</sys:String>
    <sys:String x:Key="LyricSet_OffsetX">Horizontal Offset (X)</sys:String>
    <sys:String x:Key="LyricSet_OffsetY">Vertical Offset (Y)</sys:String>
    <sys:String x:Key="LyricSet_Language">Language</sys:String>

    <!-- Secondary Action Bar & Sorting -->
    <sys:String x:Key="Btn_Back">Back</sys:String>
    <sys:String x:Key="Fmt_BackAlbum">Albums  |  {0}</sys:String>
    <sys:String x:Key="Fmt_BackArtist">Artists  |  {0}</sys:String>
    <sys:String x:Key="Btn_PlayAll">Play All</sys:String>
    <sys:String x:Key="Btn_ShuffleAll">Shuffle</sys:String>
    <sys:String x:Key="Label_SortBy">Sort by:</sys:String>
    <sys:String x:Key="Sort_AZ">A - Z</sys:String>
    <sys:String x:Key="Sort_Year">Year</sys:String>
    <sys:String x:Key="Sort_Artist">Artist</sys:String>
    <sys:String x:Key="Label_SortOrder">Order:</sys:String>
    <sys:String x:Key="Order_Asc">Ascending</sys:String>
    <sys:String x:Key="Order_Desc">Descending</sys:String>

    <!-- Empty Library & Folder Management -->
    <sys:String x:Key="Empty_Title">No local music folders added yet</sys:String>
    <sys:String x:Key="Empty_Subtitle">Drag and drop music folders here to auto-load embedded covers &amp; LRC lyrics</sys:String>
    <sys:String x:Key="Btn_SelectFolder">Select Music Folder</sys:String>
    <sys:String x:Key="Btn_AddFolderPlus">+ Add Music Folder</sys:String>
    <sys:String x:Key="Btn_RescanFolders">Rescan Library</sys:String>
    <sys:String x:Key="Tip_RemoveFolder">Remove folder</sys:String>
    <sys:String x:Key="Dlg_SelectMusicFolder">Select Local Music Folders</sys:String>

    <!-- Bottom Bar & Playback Status -->
    <sys:String x:Key="Status_NotPlaying">Not Playing</sys:String>
    <sys:String x:Key="Status_SelectToStart">Select any album or song to play</sys:String>
    <sys:String x:Key="Status_ArtistAlbumPlaceholder">Artist • Album</sys:String>
    <sys:String x:Key="Tip_Shuffle">Shuffle</sys:String>
    <sys:String x:Key="Tip_Prev">Previous</sys:String>
    <sys:String x:Key="Tip_PlayPause">Play / Pause</sys:String>
    <sys:String x:Key="Tip_Next">Next</sys:String>
    <sys:String x:Key="Tip_Repeat">Repeat Mode</sys:String>
    <sys:String x:Key="Tip_CurrentQueue">Current Queue</sys:String>
    <sys:String x:Key="Tip_ToggleTaskbarLyric">Show / Hide Taskbar Lyrics</sys:String>
    <sys:String x:Key="Tip_Mute">Mute</sys:String>
    <sys:String x:Key="Fmt_NoLyricsOverlay">♪ {0} (No Lyrics)</sys:String>

    <!-- Fullscreen Now Playing View -->
    <sys:String x:Key="Tip_BackToLibrary">Back to Library</sys:String>
    <sys:String x:Key="Lyric_InstrumentalOrNone">♪ Instrumental / No Embedded Lyrics</sys:String>
    <sys:String x:Key="Tip_LineStyle">Progress Bar Style</sys:String>
    <sys:String x:Key="LineStyle_Wavy">Wavy (Default)</sys:String>
    <sys:String x:Key="LineStyle_Straight">Straight</sys:String>
    <sys:String x:Key="LineStyle_Dashed">Dashed</sys:String>
    <sys:String x:Key="LineStyle_ThickPill">Thick Pill</sys:String>
    <sys:String x:Key="Tip_ChangeBg">Change Background Image</sys:String>
    <sys:String x:Key="Dlg_SelectBgImage">Select Fullscreen Background Image</sys:String>
    <sys:String x:Key="Dlg_ImageFilter">Image Files|*.jpg;*.jpeg;*.png;*.webp;*.bmp</sys:String>
    <sys:String x:Key="Tip_PlayQueue">Play Queue</sys:String>
    <sys:String x:Key="Tip_Fullscreen">Fullscreen / Exit (F11 / Esc)</sys:String>
    <sys:String x:Key="Fmt_QueueCount">Play Queue ({0})</sys:String>
    <sys:String x:Key="Btn_ClearQueue">Clear</sys:String>

</ResourceDictionary>