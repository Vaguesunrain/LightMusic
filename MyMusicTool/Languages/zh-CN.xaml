<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 顶部导航标签 -->
    <sys:String x:Key="Nav_Albums">专辑</sys:String>
    <sys:String x:Key="Nav_Songs">歌曲</sys:String>
    <sys:String x:Key="Nav_Artists">歌手</sys:String>
    <sys:String x:Key="Nav_Folders">文件夹</sys:String>
    <sys:String x:Key="Nav_Queue">播放列表</sys:String>

    <!-- 搜索框与顶部工具栏 -->
    <sys:String x:Key="Hint_Search">搜索音乐...</sys:String>
    <sys:String x:Key="Tip_AddFolder">添加本地音乐文件夹</sys:String>
    <sys:String x:Key="Tip_LyricSettings">调整任务栏歌词外观与位置</sys:String>
    <sys:String x:Key="Tip_MinimizeToTray">收起到系统托盘（释放封面缓存省内存）</sys:String>
    <sys:String x:Key="Tip_Minimize">最小化</sys:String>
    <sys:String x:Key="Tip_Maximize">最大化</sys:String>
    <sys:String x:Key="Tip_Exit">退出程序</sys:String>
    <sys:String x:Key="Tray_Tooltip">MyMusicTool（双击恢复主界面）</sys:String>

    <!-- 任务栏歌词设置弹出面板 -->
    <sys:String x:Key="LyricSet_Title">任务栏歌词外观与位置</sys:String>
    <sys:String x:Key="LyricSet_Font">显示字体</sys:String>
    <sys:String x:Key="LyricSet_FontSize">字体大小</sys:String>
    <sys:String x:Key="LyricSet_BgOpacity">背景胶囊透明度</sys:String>
    <sys:String x:Key="LyricSet_ColorProgress">开启随时间进度颜色过渡</sys:String>
    <sys:String x:Key="LyricSet_ShowCover">显示低清专辑封面缩略图</sys:String>
    <sys:String x:Key="LyricSet_OffsetX">水平位置偏移 (X)</sys:String>
    <sys:String x:Key="LyricSet_OffsetY">垂直位置偏移 (Y)</sys:String>
    <sys:String x:Key="LyricSet_Language">界面语言 (Language)</sys:String>

    <!-- 次级操作栏与排序 -->
    <sys:String x:Key="Btn_Back">返回</sys:String>
    <sys:String x:Key="Fmt_BackAlbum">返回专辑  |  {0}</sys:String>
    <sys:String x:Key="Fmt_BackArtist">返回歌手  |  {0}</sys:String>
    <sys:String x:Key="Btn_PlayAll">播放全部</sys:String>
    <sys:String x:Key="Btn_ShuffleAll">随机播放</sys:String>
    <sys:String x:Key="Label_SortBy">排序方式:</sys:String>
    <sys:String x:Key="Sort_AZ">A - Z</sys:String>
    <sys:String x:Key="Sort_Year">年份</sys:String>
    <sys:String x:Key="Sort_Artist">歌手</sys:String>
    <sys:String x:Key="Label_SortOrder">顺序:</sys:String>
    <sys:String x:Key="Order_Asc">升序</sys:String>
    <sys:String x:Key="Order_Desc">降序</sys:String>

    <!-- 空曲库引导与文件夹管理 -->
    <sys:String x:Key="Empty_Title">尚未添加本地音乐文件夹</sys:String>
    <sys:String x:Key="Empty_Subtitle">支持直接将音乐文件夹拖入窗口，自动识别内嵌封面与 LRC 歌词</sys:String>
    <sys:String x:Key="Btn_SelectFolder">选择本地音乐文件夹</sys:String>
    <sys:String x:Key="Btn_AddFolderPlus">+ 添加音乐文件夹</sys:String>
    <sys:String x:Key="Btn_RescanFolders">重新扫描曲库</sys:String>
    <sys:String x:Key="Tip_RemoveFolder">移除此文件夹</sys:String>
    <sys:String x:Key="Dlg_SelectMusicFolder">选择包含本地音乐的文件夹</sys:String>

    <!-- 底部控制栏 & 播放状态 -->
    <sys:String x:Key="Status_NotPlaying">未在播放</sys:String>
    <sys:String x:Key="Status_SelectToStart">选择任意专辑或歌曲开始</sys:String>
    <sys:String x:Key="Status_ArtistAlbumPlaceholder">艺术家 • 专辑</sys:String>
    <sys:String x:Key="Tip_Shuffle">随机播放</sys:String>
    <sys:String x:Key="Tip_Prev">上一首</sys:String>
    <sys:String x:Key="Tip_PlayPause">播放 / 暂停</sys:String>
    <sys:String x:Key="Tip_Next">下一首</sys:String>
    <sys:String x:Key="Tip_Repeat">循环模式</sys:String>
    <sys:String x:Key="Tip_CurrentQueue">当前播放队列</sys:String>
    <sys:String x:Key="Tip_ToggleTaskbarLyric">显示/隐藏任务栏歌词</sys:String>
    <sys:String x:Key="Tip_Mute">静音</sys:String>
    <sys:String x:Key="Fmt_NoLyricsOverlay">♪ {0}（无内嵌歌词）</sys:String>

    <!-- 全屏播放页 (NowPlayingView) -->
    <sys:String x:Key="Tip_BackToLibrary">返回曲库</sys:String>
    <sys:String x:Key="Lyric_InstrumentalOrNone">♪ 纯音乐 / 暂无内嵌歌词</sys:String>
    <sys:String x:Key="Tip_LineStyle">进度条样式设置</sys:String>
    <sys:String x:Key="LineStyle_Wavy">波浪线（默认）</sys:String>
    <sys:String x:Key="LineStyle_Straight">经典直线</sys:String>
    <sys:String x:Key="LineStyle_Dashed">分段虚线</sys:String>
    <sys:String x:Key="LineStyle_ThickPill">粗胶囊线</sys:String>
    <sys:String x:Key="Tip_ChangeBg">更换背景图片</sys:String>
    <sys:String x:Key="Dlg_SelectBgImage">选择全屏播放页背景图片</sys:String>
    <sys:String x:Key="Dlg_ImageFilter">图片文件|*.jpg;*.jpeg;*.png;*.webp;*.bmp</sys:String>
    <sys:String x:Key="Tip_PlayQueue">播放队列</sys:String>
    <sys:String x:Key="Tip_Fullscreen">全屏 / 退出全屏 (F11 / Esc)</sys:String>
    <sys:String x:Key="Fmt_QueueCount">播放队列 ({0})</sys:String>
    <sys:String x:Key="Btn_ClearQueue">清空</sys:String>
    <!-- 收藏夹 / 分类 -->
    <sys:String x:Key="Nav_Collections">收藏夹</sys:String>
    <sys:String x:Key="Btn_NewCollection">+ 新建收藏夹</sys:String>
    <sys:String x:Key="Fmt_BackCollection">返回收藏夹  |  {0}</sys:String>
    <sys:String x:Key="Fmt_CollectionCount">{0} 首歌曲</sys:String>
    <sys:String x:Key="Tip_SetCollectionBg">设定收藏夹专属背景与封面</sys:String>
    <sys:String x:Key="Tip_ResetCollectionBg">恢复默认灰白封面</sys:String>
    <sys:String x:Key="Tip_DeleteCollection">删除此收藏夹</sys:String>
    <sys:String x:Key="Menu_AddToCollection">添加到收藏夹</sys:String>
    <sys:String x:Key="Menu_NewCollectionAndAdd">+ 新建收藏夹并添加...</sys:String>
    <sys:String x:Key="Menu_RemoveFromCollection">从此收藏夹移除</sys:String>
    <sys:String x:Key="Dlg_NewCollectionTitle">新建收藏夹</sys:String>
    <sys:String x:Key="Dlg_NewCollectionHint">输入收藏夹名称</sys:String>
    <sys:String x:Key="Dlg_SelectCollectionBg">选择收藏夹专属背景与封面</sys:String>
    <sys:String x:Key="Toast_AddedToCollection">已添加到「{0}」</sys:String>
    <sys:String x:Key="Btn_AddSongsToCol">添加歌曲</sys:String>
    <sys:String x:Key="Btn_RemoveSelectedSongs">移除所选</sys:String>
    <sys:String x:Key="Dlg_SelectSongsTitle">选择要添加到「{0}」的歌曲</sys:String>
    <sys:String x:Key="Fmt_SelectedCount">已选择 {0} 首</sys:String>
    <sys:String x:Key="Btn_SelectAll">全选</sys:String>
    <sys:String x:Key="Toast_AddedMultiToCollection">已添加 {0} 首歌曲到「{1}」</sys:String>
    <sys:String x:Key="Toast_RemovedFromCollection">已移除 {0} 首歌曲</sys:String>
    <sys:String x:Key="Btn_PlayInCollections">收藏夹顺序播放</sys:String>
    <sys:String x:Key="Btn_ShuffleInCollections">收藏夹随机播放</sys:String>
    <sys:String x:Key="Toast_NoSongsInCollections">所有收藏夹中暂无歌曲</sys:String>
    <!--other-->
    <sys:String x:Key="Btn_Confirm">确认</sys:String>
    <sys:String x:Key="Btn_Cancel">取消</sys:String>
</ResourceDictionary>