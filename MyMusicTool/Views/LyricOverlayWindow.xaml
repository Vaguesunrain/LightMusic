<Window x:Class="MyMusicTool.Views.LyricOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricOverlay"
        Height="42"
        SizeToContent="Width"
        MaxWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">

    <Border x:Name="LyricPillBorder"
            Background="#CC1A1C1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,3,14,3"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 低清专辑封面缩略图（默认隐藏，开启后仅解码 36px，占约 5KB 内存） -->
            <Border x:Name="MiniCoverBorder"
                    Width="28"
                    Height="28"
                    CornerRadius="6"
                    Margin="0,0,9,0"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
                <Image x:Name="MiniCoverImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality" />
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 主歌词（支持随时间进度线性渐变扫色） -->
                <TextBlock x:Name="PrimaryLyricText"
                           Text="♪ 等待播放音乐..."
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="PlayedColorStop" Color="#7DD3FC" Offset="0" />
                            <GradientStop x:Name="UnplayedColorStop" Color="#FFFFFF" Offset="0" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <!-- 副歌词（双语翻译） -->
                <TextBlock x:Name="SecondaryLyricText"
                           Visibility="Collapsed"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>