<Window x:Class="MyMusicTool.Views.LyricOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="LyricOverlay"
        Height="42"
        SizeToContent="Width"
        MaxWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False">

    <Window.Resources>
        <Style x:Key="OverlayCtrlBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="LyricPillBorder"
            Background="#CC1A1C1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,3,14,3"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            MouseEnter="LyricPillBorder_MouseEnter"
            MouseLeave="LyricPillBorder_MouseLeave">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 低清专辑封面缩略图 -->
            <Border x:Name="MiniCoverBorder"
                    Width="28"
                    Height="28"
                    CornerRadius="6"
                    Margin="0,0,9,0"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
                <Image x:Name="MiniCoverImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality" />
            </Border>

            <Grid VerticalAlignment="Center" MinWidth="110">
                <!-- 1. 默认状态：歌词文本区 -->
                <StackPanel x:Name="LyricTextPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PrimaryLyricText"
                               Text="♪ 等待播放音乐..."
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="PlayedColorStop" Color="#7DD3FC" Offset="0" />
                                <GradientStop x:Name="UnplayedColorStop" Color="#FFFFFF" Offset="0" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <TextBlock x:Name="SecondaryLyricText"
                               Visibility="Collapsed"
                               Foreground="#CBD5E1"
                               FontSize="11"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 2. 鼠标悬浮状态：播控按钮组 -->
                <StackPanel x:Name="HoverControlsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource OverlayCtrlBtnStyle}" Click="PrevBtn_Click">
                        <materialDesign:PackIcon Kind="SkipPrevious" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource OverlayCtrlBtnStyle}" Click="PlayPauseBtn_Click">
                        <materialDesign:PackIcon x:Name="OverlayPlayPauseIcon" Kind="Play" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource OverlayCtrlBtnStyle}" Click="NextBtn_Click">
                        <materialDesign:PackIcon Kind="SkipNext" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>