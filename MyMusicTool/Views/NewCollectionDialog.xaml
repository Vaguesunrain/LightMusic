<Window x:Class="MyMusicTool.Views.NewCollectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Dlg_NewCollectionTitle}"
        Width="380"
        Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22,20"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FolderHeartOutline" Width="20" Height="20" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{DynamicResource Dlg_NewCollectionTitle}"
                           FontSize="15.5"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 输入框 -->
            <Border Grid.Row="1"
                    Background="#F1F5F9"
                    CornerRadius="10"
                    Height="40"
                    Padding="12,0"
                    VerticalAlignment="Center">
                <TextBox x:Name="NameInputBox"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         FontSize="13.5"
                         Foreground="#1E293B"
                         materialDesign:HintAssist.Hint="{DynamicResource Dlg_NewCollectionHint}"
                         KeyDown="NameInputBox_KeyDown" />
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn_Cancel}"
                        Click="Cancel_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#64748B"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Cursor="Hand" />
                <Button Content="{DynamicResource Btn_Confirm}"
                        Click="Confirm_Click"
                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Height="32"
                        Padding="18,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>