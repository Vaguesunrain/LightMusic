<UserControl x:Class="MyMusicTool.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:MyMusicTool.Controls"
             Background="#111317"
             Margin="0">
    <Grid ClipToBounds="True">
        <!-- 底层全屏自定义高清背景图 + 暗角遮罩 -->
        <Image x:Name="CustomBgImage" Stretch="UniformToFill" Opacity="0.88"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#660A0D12" Offset="0.0"/>
                    <GradientStop Color="#440A0D12" Offset="0.45"/>
                    <GradientStop Color="#CC080A0E" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 等比例自适应缩放主容器（全屏时所有组件等比例放大） -->
        <Grid x:Name="ScalableContentGrid" Margin="36,24,36,24">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部栏：仅保留极简返回按钮，最大化画面沉浸感 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Button Click="Back_Click" Width="40" Height="40" HorizontalAlignment="Left"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        Foreground="White" ToolTip="{DynamicResource Tip_BackToLibrary}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
            </Grid>

            <!-- 中上部：左对齐滚动歌词（上下边缘透明淡出 OpacityMask） -->
            <ScrollViewer x:Name="LyricsScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="8,0,120,16"
                          SizeChanged="LyricsScrollViewer_SizeChanged">
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.00"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.22"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.78"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>

                <ItemsControl x:Name="LyricsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}"
                                       FontSize="{Binding FontSize}"
                                       FontWeight="{Binding FontWeight}"
                                       Foreground="{Binding Foreground}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"
                                       LineHeight="36"
                                       Margin="0,11,0,11">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#99000000" BlurRadius="8" ShadowDepth="1" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 左下角：专辑封面 + 歌曲名 / 歌手专辑 / 无损格式参数（仿 Harmonoid 布局） -->
            <Grid Grid.Row="2" Margin="8,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="178" Height="178" CornerRadius="10"
                        Background="#1E222A" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#AA000000" BlurRadius="24" ShadowDepth="6" Opacity="0.65"/>
                    </Border.Effect>
                    <Image x:Name="LargeCoverImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,6">
                    <TextBlock x:Name="TitleText" Text="{DynamicResource Status_NotPlaying}"
                               FontSize="30" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistAlbumText" Text="{DynamicResource Status_ArtistAlbumPlaceholder}"
                               FontSize="15" Foreground="#D8E2EE" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AudioInfoText" Text="LOCAL • PURE AUDIO"
                               FontSize="13" Foreground="#A8B5C4" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 通栏进度条区域：左时间 + 多线型进度条 + 右总时长 -->
            <Grid Grid.Row="3" Margin="8,0,8,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00"
                           Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center"/>

                <controls:ExpressiveProgressSlider x:Name="ProgressSlider"
                                                   Grid.Column="1"
                                                   Height="24"
                                                   Minimum="0" Maximum="100" Value="0"
                                                   LineStyle="Wavy"
                                                   ActiveBrush="White"
                                                   InactiveBrush="#4DFFFFFF"
                                                   ThumbBrush="White"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"
                                                   ValueChanged="ProgressSlider_ValueChanged"/>

                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00"
                           Foreground="#E2E8F0" FontSize="13" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 底部控制栏：左侧播放控制 & 线型设置，右侧队列 & 全屏切换 -->
            <Grid Grid.Row="4" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Click="Prev_Click" Width="38" Height="38"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_Prev}">
                        <materialDesign:PackIcon Kind="SkipPrevious" Width="22" Height="22"/>
                    </Button>

                    <Button Click="PlayPause_Click" Width="44" Height="44" Margin="4,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_PlayPause}">
                        <materialDesign:PackIcon x:Name="PlayPauseIcon" Kind="Play" Width="26" Height="26"/>
                    </Button>

                    <Button Click="Next_Click" Width="38" Height="38"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_Next}">
                        <materialDesign:PackIcon Kind="SkipNext" Width="22" Height="22"/>
                    </Button>

                    <Button Click="Shuffle_Click" Width="36" Height="36" Margin="10,0,0,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="{DynamicResource Tip_Shuffle}">
                        <materialDesign:PackIcon x:Name="ShuffleIcon" Kind="ShuffleVariant" Width="19" Height="19" Foreground="#94A3B8"/>
                    </Button>

                    <Button Click="Repeat_Click" Width="36" Height="36" Margin="2,0,0,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="{DynamicResource Tip_Repeat}">
                        <materialDesign:PackIcon x:Name="RepeatIcon" Kind="Repeat" Width="19" Height="19" Foreground="White"/>
                    </Button>

                    <!-- 音量控制 -->
                    <Button Click="Mute_Click" Width="36" Height="36" Margin="10,0,0,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_Mute}">
                        <materialDesign:PackIcon x:Name="VolumeIcon" Kind="VolumeHigh" Width="19" Height="19"/>
                    </Button>
                    <Slider x:Name="VolumeSlider"
        Width="92"
        Minimum="0"
        Maximum="1"
        Value="0.8"
        Foreground="White"
        Cursor="Hand"
        IsMoveToPointEnabled="True"
        VerticalAlignment="Center"
        Margin="4,0,12,0"
        ValueChanged="VolumeSlider_ValueChanged" />

                    <!-- 进度条线型设置菜单按钮（直线 / 波浪线 / 虚线 / 粗胶囊线） -->
                    <Button x:Name="LineStyleButton" Click="OpenLineStyleMenu_Click" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White"
                            ToolTip="{DynamicResource Tip_LineStyle}">
                        <materialDesign:PackIcon Kind="Wave" Width="20" Height="20"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LineStyleContextMenu">
                                <MenuItem Header="{DynamicResource LineStyle_Wavy}" Tag="Wavy" Click="SelectLineStyle_Click"/>
                                <MenuItem Header="{DynamicResource LineStyle_Straight}" Tag="Straight" Click="SelectLineStyle_Click"/>
                                <MenuItem Header="{DynamicResource LineStyle_Dashed}" Tag="Dashed" Click="SelectLineStyle_Click"/>
                                <MenuItem Header="{DynamicResource LineStyle_ThickPill}" Tag="ThickPill" Click="SelectLineStyle_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 自定义背景图片 -->
                    <Button Click="SelectCustomBg_Click" Width="36" Height="36" Margin="2,0,0,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White"
                            ToolTip="{DynamicResource Tip_ChangeBg}">
                        <materialDesign:PackIcon Kind="ImageOutline" Width="19" Height="19"/>
                    </Button>
                </StackPanel>

                <!-- 右下角：播放队列抽屉 + 全屏按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="ToggleQueueDrawer_Click" Width="38" Height="38" Margin="0,0,4,0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_PlayQueue}">
                        <materialDesign:PackIcon Kind="PlaylistMusic" Width="21" Height="21"/>
                    </Button>

                    <Button Click="ToggleFullscreen_Click" Width="38" Height="38"
                            Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" ToolTip="{DynamicResource Tip_Fullscreen}">
                        <materialDesign:PackIcon x:Name="FullscreenIcon" Kind="Fullscreen" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 右侧滑出播放队列抽屉 -->
        <Border x:Name="QueueDrawerBorder" Visibility="Collapsed"
                HorizontalAlignment="Right" Width="340" Margin="0,24,24,84"
                CornerRadius="16" Background="#E6141820" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="QueueCountText" Text="{DynamicResource Fmt_QueueCount}" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="ClearQueue_Click" Content="{DynamicResource Btn_ClearQueue}" Foreground="#94A3B8"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2"/>
                        <Button Click="CloseQueueDrawer_Click" Width="30" Height="30"
                                Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="QueueListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="QueueListBox_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Artist}" Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{Binding}" Click="RemoveQueueItem_Click"
                                        Width="28" Height="28" Foreground="#94A3B8"
                                        Style="{StaticResource MaterialDesignIconForegroundButton}">
                                    <materialDesign:PackIcon Kind="Close" Width="15" Height="15"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>