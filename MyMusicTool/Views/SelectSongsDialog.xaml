<Window x:Class="MyMusicTool.Views.SelectSongsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="540"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题与关闭 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="DialogTitleText"
                           FontSize="15.5"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button HorizontalAlignment="Right"
                        Click="Cancel_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Cursor="Hand">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#64748B" />
                </Button>
            </Grid>

            <!-- 搜索框 + 全选按钮 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="10" Height="36" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchInput"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Foreground="#1E293B"
                                 materialDesign:HintAssist.Hint="{DynamicResource Hint_Search}"
                                 TextChanged="SearchInput_TextChanged" />
                        <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Content="{DynamicResource Btn_SelectAll}"
                        Click="SelectAll_Click"
                        Background="#F1F5F9"
                        Foreground="#334155"
                        BorderThickness="0"
                        Padding="12,0"
                        Height="36"
                        Margin="8,0,0,0"
                        Cursor="Hand" />
            </Grid>

            <!-- 多选歌曲列表 -->
            <ListBox x:Name="CandidateListBox"
                     Grid.Row="2"
                     SelectionMode="Extended"
                     Background="Transparent"
                     BorderBrush="#E2E8F0"
                     BorderThickness="1"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="CandidateListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部已选统计与确认按钮 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="SelectedCountText"
                           FontSize="12.5"
                           Foreground="#64748B"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Btn_Cancel}"
                            Click="Cancel_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#64748B"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Cursor="Hand" />
                    <Button Content="{DynamicResource Btn_Confirm}"
                            Click="Confirm_Click"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Height="34"
                            Padding="20,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>